<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<FinalDraft DocumentType="Script" Template="No" Version="5">

  <Content>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">FADE IN:</Text>
    </Paragraph>
    <Paragraph Number="1" Type="Scene Heading">
      <SceneProperties Length="9/8" Page="1" Title="">
        <Summary>Farmhouse Kitchen beat.</Summary>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">INT. FARMHOUSE KITCHEN - DAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">He turns the letter opener over in his hands, weighing it.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">DEPUTY COLE (CONT'D)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Nobody's coming, Harlan.</Text>
    </Paragraph>
    <Paragraph Number="2" Type="Scene Heading">
      <SceneProperties Length="8/8" Page="1" Title="">
        <Summary>Gravel Driveway beat.</Summary>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">EXT. GRAVEL DRIVEWAY - DAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Dust hangs in the light from the window.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">MAE (CONT'D)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="1" Size="12" Style="">Nobody's coming, Harlan.</Text>
    </Paragraph>
    <Paragraph Number="3" Type="Scene Heading">
      <SceneProperties Length="3/8" Page="2" Title="">
        <Summary>Harlan'S Study beat.</Summary>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">INT. HARLAN'S STUDY - NIGHT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">He turns the letter opener over in his hands, weighing it.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">MAE (CONT'D)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">You should have called first.</Text>
    </Paragraph>
    <Paragraph Number="4" Type="Scene Heading">
      <SceneProperties Length="2/8" Page="2" Title="">
        <Summary>Wheat Field beat.</Summary>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">EXT. WHEAT FIELD - DUSK</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">He turns the letter opener over in his hands, weighing it.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">DOC REYES</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Sign it and we're done.</Text>
    </Paragraph>
    <Paragraph Number="5" Type="Scene Heading">
      <SceneProperties Length="7/8" Page="3" Title="">
        <Summary>County Sheriff'S Office beat.</Summary>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">INT. COUNTY SHERIFF'S OFFICE - DAY</Text>
      <ScriptNote><Paragraph><Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Confirm practical lamp is available.</Text></Paragraph></ScriptNote>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">He pockets the brass key without looking at it.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">JANITOR</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">I know what you did out there.</Text>
    </Paragraph>
    <Paragraph Number="6" Type="Scene Heading">
      <SceneProperties Length="3/8" Page="3" Title="">
        <Summary>Pickup Truck - Moving beat.</Summary>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">INT. PICKUP TRUCK - MOVING - NIGHT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Dust hangs in the light from the window.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">HARLAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Sign it and we're done.</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">FADE OUT.</Text>
    </Paragraph>
  </Content>

  <TitlePage>
    <Content>
      <Paragraph Alignment="Center" Type="General">
        <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">THE LONG ACRE</Text>
      </Paragraph>
      <Paragraph Alignment="Center" Type="General">
        <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Written by A. Writer</Text>
      </Paragraph>
    </Content>
  </TitlePage>

  <HeaderAndFooter FooterVisible="No" HeaderVisible="Yes">
    <Header>
      <Paragraph Alignment="Right">
        <DynamicLabel Type="Page #"/>
        <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">THIS IS A PAGE HEADER, NOT SCREENPLAY ACTION</Text>
      </Paragraph>
    </Header>
  </HeaderAndFooter>

  <Watermarking Opacity="70" Position="Diagonal Descending">
    <DynamicContent>
      <Paragraph Alignment="Left">
        <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">CONFIDENTIAL WATERMARK, NOT SCREENPLAY ACTION</Text>
      </Paragraph>
    </DynamicContent>
  </Watermarking>

  <Revisions ActiveSet="2" RevisionMode="Yes" RevisionsShown="All">
    <Revision Color="#00000000FFFF" FullRevision="No" ID="1" Mark="*" Name="Blue" PageColor="#FFFFFFFFFFFF" Style=""/>
    <Revision Color="#FFFF0000FFFF" FullRevision="No" ID="2" Mark="*" Name="Pink" PageColor="#FFFFFFFFFFFF" Style=""/>
    <Revision Color="#A0A0A00000" FullRevision="No" ID="3" Mark="*" Name="Yellow" PageColor="#FFFFFFFFFFFF" Style=""/>
    <Revision Color="#000080800000" FullRevision="No" ID="4" Mark="*" Name="Green" PageColor="#FFFFFFFFFFFF" Style=""/>
    <Revision Color="#CCCC7F7F3232" FullRevision="No" ID="5" Mark="*" Name="Goldenrod" PageColor="#FFFFFFFFFFFF" Style=""/>
    <Revision Color="#8E8E6B6B2323" FullRevision="No" ID="6" Mark="*" Name="Buff" PageColor="#FFFFFFFFFFFF" Style=""/>
    <Revision Color="#A7A742424242" FullRevision="No" ID="7" Mark="*" Name="Salmon" PageColor="#FFFFFFFFFFFF" Style=""/>
    <Revision Color="#D5D523236B6B" FullRevision="No" ID="8" Mark="*" Name="Cherry" PageColor="#FFFFFFFFFFFF" Style=""/>
    <Revision Color="#DBDB93937070" FullRevision="No" ID="9" Mark="*" Name="Tan" PageColor="#FFFFFFFFFFFF" Style=""/>
  </Revisions>

  <SceneNumberOptions NumberScheme="1A" ShowNumbersOnLeft="Yes" ShowNumbersOnRight="Yes"/>
</FinalDraft>
