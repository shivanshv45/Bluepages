# ---------------------------------------------------------------------------
# Bluepages: environment
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- AWS / Bedrock (Layer 0) ------------------------------------------------
# Region must be one where you enabled Claude model access.
AWS_REGION=us-west-2
# Leave the keys unset to use your AWS CLI profile or an instance role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=default

# Bedrock model IDs. Inference-profile ARNs also work here.
BEDROCK_MODEL_JUDGMENT=anthropic.claude-sonnet-5
BEDROCK_MODEL_BULK=anthropic.claude-haiku-4-5

# --- Fallback providers (Layer 3.5) ----------------------------------------
# Optional. Used only on throttling / timeout / 5xx, never on schema errors.
# GROQ_API_KEY=
# GEMINI_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.0-flash

# --- Storage (Layer 4 / 6) --------------------------------------------------
# S3_BUCKET=bluepages-scripts
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
# The direct Postgres connection string, not the API URL. Without it the
# element database is a local SQLite file, which is fine for development.
# SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# --- Email (Layer 8) --------------------------------------------------------
# RESEND_API_KEY=
# RESEND_FROM=bluepages@yourdomain.com

# --- Agent runtime ----------------------------------------------------------
# "strands" runs every Bedrock call through a Strands agent. "boto3" uses the
# raw Converse call. Both enforce the same ceiling, cache and fallback chain.
BLUEPAGES_AGENT_RUNTIME=strands

# --- Cost guards (CLAUDE.md: never an unbounded loop, always max_tokens) ----
BLUEPAGES_MAX_TOKENS=4096
BLUEPAGES_MAX_LLM_CALLS_PER_RUN=400
BLUEPAGES_CACHE_LLM=true
BLUEPAGES_LOG_LEVEL=INFO
