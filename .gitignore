# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Env / secrets
.env
.env.local
.env.*.local
!.env.example

# AWS
.aws-sam/
samconfig.toml

# Cache of LLM responses during iteration (CLAUDE.md: cache responses)
.cache/

# Local element database, when Supabase is not configured
.bluepages/
*.db

# Third-party screenplay PDFs: fetched by scripts/fetch_fixtures.py, not ours
# to redistribute. The .fdx fixtures and the rendered PDF are committed.
tests/fixtures/real-screenplay*.pdf

# Run artifacts
out/
*.log

# Drafts uploaded through the API at runtime. Regenerated by app.py's own
# workspace.mkdir on first upload; never something to commit.
workspace/

# Node (Layer 7)
node_modules/
.vite/
dist-ssr/
# Vite's build output. Covered by the Python `dist/` rule above by accident,
# so name it here too rather than relying on that.
frontend/dist/
# TypeScript's incremental build cache. Machine-local, regenerated every build.
*.tsbuildinfo

# Vercel's project linkage, written by `vercel` on first deploy. Contains the
# project and org ids, and is per-developer rather than per-project.
.vercel/

# Demo/mock frontend: reference only, not pushed to GitHub
web/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json

# Internal working docs. Not the artifact, and not tracked. README and LICENSE
# stay in the repo: a public project needs both.
PRD.md
PLAN.md
DECISIONS.md
CHANGES.md
CLAUDE.md

# Decisions taken while you were away. Internal, like the other working docs.
APPROVAL.md

# Frontend (Layer 7)
web/node_modules/
web/dist/
web/shot.mjs
web/live.mjs

# The design direction. Internal working doc like the others.
DESIGN.md

# Layer 9 working plan. Internal, like the other planning docs.
PLAN-LAYER-9.md

# Demo video shot list. Internal prep, not the recording itself.
DEMO.md

# Third-party footage: fetched, not ours to redistribute.
tests/fixtures/video/

# Hackathon submission packaging and AWS deploy scaffolding. Local only, not
# part of the pushed project.
submission/
deploy/
